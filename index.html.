<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LOTAK | Gaming</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #090911;
  color: white;
}
header {
  padding: 22px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #11111e;
  border-bottom: 1px solid #29243d;
}
.logo {
  font-size: 30px;
  font-weight: 900;
  color: #a879ff;
  letter-spacing: 3px;
}
nav a {
  color: white;
  text-decoration: none;
  margin-left: 20px;
}
.hero {
  text-align: center;
  padding: 85px 20px;
  background: linear-gradient(135deg,#19112e,#101020,#24113b);
}
.hero h1 { font-size: 48px; margin: 0 0 15px; }
.hero span { color: #b68aff; }
.hero p { color: #c5c1d0; font-size: 17px; }
main { padding: 35px 7%; }
h2 { margin-bottom: 25px; }
.games {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(210px,1fr));
  gap: 20px;
}
.game {
  background: #171725;
  border: 1px solid #302b43;
  border-radius: 14px;
  padding: 25px;
  transition: .2s;
}
.game:hover {
  transform: translateY(-5px);
  border-color: #a879ff;
}
.game .emoji { font-size: 45px; }
.game h3 { margin-bottom: 8px; }
.game p { color: #aaa5b8; font-size: 14px; }
button {
  background: #8955e9;
  color: white;
  border: 0;
  border-radius: 8px;
  padding: 11px 17px;
  cursor: pointer;
  font-weight: bold;
}
button:hover { background: #a879ff; }
footer {
  text-align: center;
  padding: 25px;
  color: #888;
  border-top: 1px solid #29243d;
}
</style>
</head>
<body>

<header>
  <div class="logo">LOTAK</div>
  <nav>
    <a href="#inicio">Inicio</a>
    <a href="#juegos">Juegos</a>
    <a href="#categorias">Categorías</a>
  </nav>
</header>

<section class="hero" id="inicio">
  <h1>BIENVENIDO A <span>LOTAK</span></h1>
  <p>Tu plataforma de videojuegos favorita.</p>
  <a href="#juegos"><button>EXPLORAR JUEGOS</button></a>
</section>

<main>
  <section id="juegos">
    <h2>🎮 Juegos destacados</h2>
    <div class="games">
      <div class="game">
        <div class="emoji">🏎️</div>
        <h3>Juegos de carreras</h3>
        <p>Velocidad y competición.</p>
        <button onclick="alert('Próximamente')">Ver juegos</button>
      </div>
      <div class="game">
        <div class="emoji">⚔️</div>
        <h3>Acción</h3>
        <p>Aventura y desafíos.</p>
        <button onclick="alert('Próximamente')">Ver juegos</button>
      </div>
      <div class="game">
        <div class="emoji">⚽</div>
        <h3>Deportes</h3>
        <p>Compite y demuestra tu habilidad.</p>
        <button onclick="alert('Próximamente')">Ver juegos</button>
      </div>
      <div class="game">
        <div class="emoji">🧩</div>
        <h3>Rompecabezas</h3>
        <p>Entrena tu mente.</p>
        <button onclick="alert('Próximamente')">Ver juegos</button>
      </div>
    </div>
  </section>

  <section id="categorias" style="margin-top:50px">
    <h2>✨ Sobre LOTAK</h2>
    <p>Un lugar para descubrir y disfrutar de videojuegos de todo tipo.</p>
  </section>
</main>

<footer>
  © 2026 LOTAK - Tu mundo gaming
</footer>

</body>
</html>




